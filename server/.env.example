# Database
DATABASE_URL=host=postgres user=postgres password=postgres dbname=amora port=5432 sslmode=disable

# JWT
JWT_SECRET=your-super-secret-key-change-in-production

# Server
SERVER_PORT=8080
GIN_MODE=release

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Environment
ENVIRONMENT=development
